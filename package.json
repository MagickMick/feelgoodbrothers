{
  "name": "feelgoodbrothers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fgb/web",
    "dev:web": "npm run dev --workspace=@fgb/web",
    "dev:admin": "npm run dev --workspace=@fgb/admin",
    "build": "npm run build --workspace=@fgb/web && npm run build --workspace=@fgb/admin",
    "db:generate": "npm run db:generate --workspace=@fgb/core",
    "db:migrate": "npm run db:migrate --workspace=@fgb/core",
    "import-mdx": "npm run import-mdx --workspace=@fgb/core",
    "create-admin": "npm run create-admin --workspace=@fgb/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
