---
// main layout
import BaseLayout from "@layouts/BaseLayout.astro";

// components
import Button from "@components/Button/Button.astro";

Astro.response.status = 404;
---

<BaseLayout title="404 - Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex={true}>
  <section class="site-container pt-24 md:pt-36">
    <div class="w-full rounded-xl bg-base-200/50 py-20 text-center md:py-32">
      <div class="mx-auto max-w-xl px-4 text-center">
        <h1 class="h1">Pagina niet gevonden</h1>
        <p class="description mt-4">
          Sorry, deze pagina bestaat niet (meer). Ga terug naar de homepage of
          bekijk al onze blogs.
        </p>
        <div class="mt-8 flex justify-center">
          <Button variant="primary" href="/nl/">Naar de homepage</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
