---
import BaseLayout from "@layouts/BaseLayout.astro";
import CategoryCloud from "@components/CategoryCloud/CategoryCloud.astro";
---

<BaseLayout
  title="All topics: anxiety, panic attacks, derealization and more"
  description="Browse all topics we write about: panic attacks, anxiety, derealization, high sensitivity, mindfulness and more."
>
  <section class="site-container pt-36 md:pt-44">
    <div class="mx-auto max-w-3xl">
      <h1 class="h1 text-center">Categories</h1>
      <div class="mt-10 flex justify-center">
        <CategoryCloud showCount={true} />
      </div>
    </div>
  </section>
</BaseLayout>
