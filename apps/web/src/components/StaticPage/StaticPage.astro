---
import { getEntry, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ExternalLink from "@components/MarkdownComponents/ExternalLink.astro";

interface Props {
  locale: "en" | "nl";
  page: string;
}

const { locale, page } = Astro.props as Props;
const entry = (await getEntry("otherPages", `${locale}/${page}`))!;
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<BaseLayout title={title} description={description}>
  <section class="site-container pt-24 md:pt-36">
    <div class="w-full rounded-xl bg-base-200/50 py-20 text-center md:py-32">
      <h1 class="h1">{title}</h1>
    </div>
    <div class="mx-auto max-w-3xl">
      <div class="text-base-content prose mt-10 max-w-none text-sm md:text-base">
        <Content components={{ a: ExternalLink }} />
      </div>
    </div>
  </section>
</BaseLayout>
