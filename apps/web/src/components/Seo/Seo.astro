---
/**
 * All SEO tags for a page: title, description, canonical, hreflang, robots,
 * Open Graph, X (Twitter) cards and JSON-LD.
 */
import { absoluteUrl, SITE_URL } from "@fgb/core/posts";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getLocalizedPathname, getTranslatedData } from "@js/translationUtils";
import { locales, defaultLocale, localeMap } from "@config/siteSettings.json";

export interface SeoImage {
  url: string;
  width: number;
  height: number;
  alt: string;
}

export interface SeoArticle {
  publishedTime: Date;
  modifiedTime?: Date | null;
  authorUrl?: string;
  section?: string;
  tags?: string[];
}

export interface Props {
  title: string;
  description: string;
  image?: SeoImage;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  /** override canonical (absolute URL or path) */
  canonical?: string | null;
  article?: SeoArticle;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  ogType = "website",
  noindex = false,
  canonical,
  article,
  jsonLd = [],
} = Astro.props as Props;

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
const brand = "Feelgood Brothers";

const fullTitle = title.toLowerCase().includes(brand.toLowerCase()) ? title : `${title} | ${brand}`;

// canonical: path with trailing slash, never query strings
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ? absoluteUrl(canonical) : absoluteUrl(path);

// hreflang: explicit alternates for DB pages, otherwise derived from the route
const explicit = Astro.locals.alternates;
const alternates: { lang: string; href: string }[] = [];
for (const l of locales) {
  const href = explicit ? explicit[l] : getLocalizedPathname(l, Astro.url);
  if (href) alternates.push({ lang: l, href: absoluteUrl(href) });
}
const xDefault =
  alternates.find((a) => a.lang === defaultLocale)?.href ?? alternates[0]?.href;

const ogImage: SeoImage = image ?? {
  url: siteData.defaultImage.src,
  width: 1200,
  height: 630,
  alt: siteData.defaultImage.alt,
};
const ogImageUrl = absoluteUrl(ogImage.url);
const twitterHandle = siteData.author.twitter ? `@${siteData.author.twitter.replace(/^@/, "")}` : null;

const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// escape "</" so JSON can never close the script tag
const ldJson = jsonLd.map((o) => JSON.stringify(o).replace(/</g, "\\u003c"));
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />

{
  !noindex &&
    alternates.length > 1 &&
    alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)
}
{!noindex && alternates.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={brand} />
<meta property="og:locale" content={localeMap[currLocale].replace("-", "_")} />
{
  locales
    .filter((l) => l !== currLocale && alternates.some((a) => a.lang === l))
    .map((l) => <meta property="og:locale:alternate" content={localeMap[l].replace("-", "_")} />)
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      <meta
        property="article:modified_time"
        content={(article.modifiedTime ?? article.publishedTime).toISOString()}
      />
      {article.authorUrl && <meta property="article:author" content={absoluteUrl(article.authorUrl)} />}
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImage.alt} />

<!-- feeds -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${brand} (EN)`}
  href={`${SITE_URL}/rss.xml`}
/>
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${brand} (NL)`}
  href={`${SITE_URL}/nl/rss.xml`}
/>

{ldJson.map((json) => <script type="application/ld+json" set:html={json} />)}
