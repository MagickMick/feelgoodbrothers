VPS_USER=root
SSH_KEY=$HOME/.ssh/feelgoodbrothers_vps
DOCKER_CONTEXT=feelgoodbrothers
REMOTE_DIR=/opt/feelgoodbrothers
IMAGE_PREFIX=magickmick/feelgoodbrothers
LETSENCRYPT_EMAIL=
