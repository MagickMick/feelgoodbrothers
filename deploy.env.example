# Copy to deploy.env (gitignored) and fill in. Used by ./deploy.sh.
# The site runs on the Weggeefdeals VPS, next to the stacks "weggeefdeals" and "tintexclusive".
DOCKER_CONTEXT=weggeefdeals
VPS_IP=187.124.189.127
# hostnames on the certificate. Before the switch: new + admin. At the switch add the apex and www:
# DOMAINS="feelgoodbrothers.com www.feelgoodbrothers.com new.feelgoodbrothers.com admin.feelgoodbrothers.com"
DOMAINS="new.feelgoodbrothers.com admin.feelgoodbrothers.com"
# email for Let's Encrypt expiry notices (optional)
CERT_EMAIL=
# where the Weggeefdeals stack keeps its nginx config and certificates on the server
WG_STACK=weggeefdeals
REMOTE_NGINX_DIR=/opt/weggeefdeals/nginx
REMOTE_CERTBOT_DIR=/opt/weggeefdeals/certbot
