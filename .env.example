# ---------------------------------------------------------------------------
# Production settings. On the VPS this file lives at /opt/feelgoodbrothers/.env
# (never commit the real file). Local docker compose needs no .env.
# ---------------------------------------------------------------------------

# Postgres (generate with: openssl rand -hex 24)
POSTGRES_DB=feelgoodbrothers
POSTGRES_USER=fgb
POSTGRES_PASSWORD=

# Public URLs
SITE_URL=https://feelgoodbrothers.com
ADMIN_URL=https://admin.feelgoodbrothers.com
ADMIN_TIMEZONE=Europe/Amsterdam

# Optional: Cloudflare cache purge after publishing (Zone ID + API token with "Cache Purge" permission)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Writing assistant (admin only). Start with OpenAI; Claude is optional.
# Note: a ChatGPT/Claude subscription is not an API key. Create keys at
# platform.openai.com and console.anthropic.com (billed per use).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: IndexNow key (generate with: openssl rand -hex 16). Bing/Yandex get pinged on publish.
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Only for `npm run dev` outside Docker (connects to the compose postgres)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://fgb:fgb_local_dev@localhost:5432/feelgoodbrothers
# UPLOADS_DIR=../../uploads
