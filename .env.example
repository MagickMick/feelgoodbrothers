# ---------------------------------------------------------------------------
# Production settings: copy to .env.production (gitignored, never commit it) and fill in.
# ./deploy.sh reads it locally and passes the values to the stack; nothing is copied to the server
# as a file. Local docker compose needs no .env (an optional local .env only holds AI keys).
# ---------------------------------------------------------------------------

# Postgres (generate with: openssl rand -hex 24)
POSTGRES_DB=feelgoodbrothers
POSTGRES_USER=fgb
POSTGRES_PASSWORD=

# Public URLs
SITE_URL=https://feelgoodbrothers.com
ADMIN_URL=https://admin.feelgoodbrothers.com
ADMIN_TIMEZONE=Europe/Amsterdam

# Optional: Cloudflare cache purge after publishing (Zone ID + API token with "Cache Purge" permission)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Writing assistant (admin only). Start with OpenAI; Claude is optional.
# Note: a ChatGPT/Claude subscription is not an API key. Create keys at
# platform.openai.com and console.anthropic.com (billed per use).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Read-aloud audio per blog ("Maak voorlezing" in the editor) uses OpenAI text to speech with
# OPENAI_API_KEY (about $0.015 per minute of audio). Voices: alloy, ash, ballad, cedar, coral,
# echo, fable, marin, nova, onyx, sage, shimmer, verse. Leave empty for the defaults.
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE_EN=
OPENAI_TTS_VOICE_NL=

# Mail for the admin login (2FA code + lockout warnings). Required in production: without it
# nobody can log in. Same setup as TransferNews. Gmail: smtp.gmail.com, port 587, your Gmail
# address as EMAIL_USER and an app password (Google account > Security > App passwords) as
# EMAIL_PASS. EMAIL_FROM must be that address or a verified "send as" alias.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional: IndexNow key (generate with: openssl rand -hex 16). Bing/Yandex get pinged on publish.
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Only for `npm run dev` outside Docker (connects to the compose postgres)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://fgb:fgb_local_dev@localhost:5432/feelgoodbrothers
# UPLOADS_DIR=../../uploads
